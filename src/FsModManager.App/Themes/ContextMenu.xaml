<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= ContextMenu ================= -->
    <!-- Floating dark menu: surface panel background (not pure black), 1px border, 4px
         corners (same convention as Button/ListBox/ComboBox), and a soft drop shadow so
         the menu reads as a layer floating above the dark UI behind it. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Right/bottom margin leaves room inside the transparent popup for the shadow to render into -->
                    <Border x:Name="Border"
                            Margin="0,0,10,10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="14"
                                              ShadowDepth="2"
                                              Direction="270"
                                              Opacity="0.55"
                                              RenderingBias="Quality" />
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True">
                            <!-- ClearTypeHint keeps text crisp inside the transparency-enabled popup -->
                            <ItemsPresenter RenderOptions.ClearTypeHint="Enabled"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= MenuItem ================= -->
    <!-- High-contrast text on the dark surface; hover uses the same accent treatment as a
         selected ListBoxItem (SelectionBrush fill + AccentBrush edge). The icon column is a
         fixed-width gutter so every item aligns now and icons can be added later without
         shifting text. Disabled items are dimmed hard (opacity 0.4 + secondary text color)
         and never show the hover highlight. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Reserved icon gutter (binds to MenuItem.Icon when set) -->
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <!-- Reserved submenu-arrow strip -->
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                            <ContentPresenter x:Name="HeaderPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="0,0,12,0" />

                            <TextBlock x:Name="GestureText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />

                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="3"
                                  Data="M 0 0 L 4.5 4.5 L 0 9 Z"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="7"
                                  Height="9"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />

                            <!-- Submenu popup: same surface/border/corner/shadow language as the ContextMenu itself -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   HorizontalOffset="-2"
                                   VerticalOffset="-4"
                                   PopupAnimation="Fade">
                                <Border x:Name="SubmenuBorder"
                                        Margin="0,0,10,10"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                          BlurRadius="14"
                                                          ShadowDepth="2"
                                                          Direction="270"
                                                          Opacity="0.55"
                                                          RenderingBias="Quality" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter RenderOptions.ClearTypeHint="Enabled" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter Property="Visibility" TargetName="SubmenuArrow" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Visibility" TargetName="SubmenuArrow" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="ItemBorder" Value="{StaticResource SelectionBrush}" />
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{StaticResource AccentBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="ItemBorder" Value="{StaticResource ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Separator (menus) ================= -->
    <!-- Thin mid-tone line, inset from the edges and aligned with the item text column,
         with vertical breathing room so it never crowds adjacent item text. -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="29,5,8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="{TemplateBinding Margin}"
                            Background="{StaticResource BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
