<UserControl x:Class="FsModManager.App.Views.AddModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8" MaxWidth="500" HorizontalAlignment="Left">
        <TextBlock Text="Download URL" FontWeight="Bold" />
        <TextBox Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Destination File Name (e.g. MyMod.zip)" FontWeight="Bold" />
        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <Button Content="Download and Add" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />

        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="16" Margin="0,0,0,8" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
