<UserControl x:Class="FsModManager.App.Views.LoadOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Load Order" FontSize="24" FontWeight="SemiBold" />
            <Button Content="Refresh savegames"
                    Command="{Binding RefreshSavegamesCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Savegame picker -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
            <TextBlock Text="Savegame:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox ItemsSource="{Binding Savegames}"
                      SelectedItem="{Binding SelectedSavegame}"
                      MinWidth="360"
                      HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding DisplayName}" />
                            </TextBlock>
                            <TextBlock Text="{Binding FolderPath}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Multiplayer hint: preparing a savegame is the natural moment to compare mod lists
             with whoever you're about to play with. -->
        <Border Grid.Row="2"
                Padding="10,8"
                Margin="0,0,0,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding ShowMultiplayerHint, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,160,0"
                           Text="Playing multiplayer with this save? Export a manifest of its active mods and compare against your friends' or server's list first." />
                <Button Content="Open Multiplayer Sync"
                        Command="{Binding GoToMultiplayerSyncCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Empty state: no savegames -->
        <Border Grid.Row="2"
                Padding="32"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520">
                No savegames found under Documents\My Games\FarmingSimulator2025. Start the game and create a save first.
            </TextBlock>
        </Border>

        <!-- Empty state: savegames exist but none picked yet -->
        <Border Grid.Row="2"
                Padding="32"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                Visibility="{Binding ShowSelectPrompt, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Select a savegame above to view its load order."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
        </Border>

        <!-- Empty state: a savegame is selected but its load order has no mods -->
        <Border Grid.Row="2"
                Padding="32"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                Visibility="{Binding ShowNoEntriesMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No mods found in this savegame's load order."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
        </Border>

        <!-- Reorderable load-order list -->
        <ListBox x:Name="EntryList"
                 Grid.Row="2"
                 AllowDrop="True"
                 ItemsSource="{Binding Entries}"
                 PreviewMouseLeftButtonDown="OnEntryPreviewMouseLeftButtonDown"
                 PreviewMouseMove="OnEntryPreviewMouseMove"
                 DragOver="OnEntryDragOver"
                 Drop="OnEntryDrop"
                 Visibility="{Binding ShowEntries, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⠿"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Cursor="SizeAll" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding InternalModName}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InternalModName}" />
                        <ToggleButton Grid.Column="2"
                                      Content="{Binding ActiveText}"
                                      IsChecked="{Binding Active}"
                                      VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Backups: snapshot history for the selected savegame -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ShowBackupsPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Backups"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalBackupSizeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Open backups folder"
                                Command="{Binding OpenBackupsFolderCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Create backup now"
                                Command="{Binding CreateBackupCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,0,0,8">
                    Full copies of this savegame, stored in a FsModManagerBackups folder next to the game's own savegame folders — never inside one, so the game can't mistake a backup for a save. A snapshot is taken automatically before every load-order save; backups you create manually are kept indefinitely.
                </TextBlock>

                <!-- Empty state: no snapshots yet — explain the feature instead of showing a blank list -->
                <Border Padding="14"
                        Background="{StaticResource ControlBrush}"
                        CornerRadius="4"
                        Visibility="{Binding ShowBackupsEmptyState, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                        No backups yet for this savegame. If a save ever gets corrupted or disappears from the game's list, you can roll back to a known-good snapshot from here. Use "Create backup now" to make your first one.
                    </TextBlock>
                </Border>

                <!-- Snapshot history, newest first -->
                <ListBox ItemsSource="{Binding Snapshots}"
                         MaxHeight="220"
                         Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CreatedText}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Padding="6,1"
                                            Margin="0,0,8,0"
                                            CornerRadius="8"
                                            Background="{StaticResource AccentBrush}"
                                            Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="manual"
                                                   Foreground="{StaticResource TextOnAccentBrush}"
                                                   FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Reason}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowReasonText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0" />
                                <Button Grid.Column="3"
                                        Content="Restore"
                                        Padding="10,4"
                                        MinHeight="0"
                                        Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Footer: game-running notice + actions -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <Border Padding="10,8"
                    Margin="0,0,0,10"
                    Background="{StaticResource WarningBannerBrush}"
                    BorderBrush="{StaticResource LikelyBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                    Farming Simulator 25 is currently running. Saving the load order and creating or restoring backups are disabled until you close the game.
                </TextBlock>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save load order"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Launch game"
                        Command="{Binding LaunchGameCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
